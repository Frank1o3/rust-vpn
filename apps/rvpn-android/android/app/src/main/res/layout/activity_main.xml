<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/sectionMain"
            layout="@layout/section_main" />

        <include
            android:id="@+id/sectionTunnel"
            layout="@layout/section_tunnel"
            android:visibility="gone" />

        <include
            android:id="@+id/sectionServer"
            layout="@layout/section_server"
            android:visibility="gone" />

        <include
            android:id="@+id/sectionAdvanced"
            layout="@layout/section_advanced"
            android:visibility="gone" />

    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>