[Unit]
Description=RVPN server
Documentation=https://github.com/Frank1o3/rust-vpn
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rvpn
Group=rvpn
RuntimeDirectory=rvpn
RuntimeDirectoryMode=0700
Environment=RVPN_RUNTIME_DIR=/run/rvpn
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
ExecStart=/usr/local/bin/rvpn-server /var/lib/rvpn/.config/rvpn/server.toml
Restart=on-failure
RestartSec=2
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
