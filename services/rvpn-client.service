[Unit]
Description=RVPN client daemon (control socket for rvpn-tray)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
ExecStart=/usr/local/bin/rvpn-client --daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target