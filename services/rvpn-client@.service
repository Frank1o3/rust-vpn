[Unit]
Description=RVPN Client (%i)
Documentation=https://github.com/Frank1o3/rust-vpn

Wants=network-online.target
After=network-online.target

[Service]
Type=simple

# Run the daemon as the target user's normal account.
# The instance name is the Linux username.
User=%i

# A system service does not inherit the logged-in user's
# XDG_RUNTIME_DIR. Resolve the UID after User= has been applied,
# then point the client at that user's runtime directory.
ExecStart=/bin/sh -c 'export XDG_RUNTIME_DIR=/run/user/$$(id -u); exec /usr/local/bin/rvpn-client --daemon'

Restart=on-failure
RestartSec=3s

# Allow the non-root daemon to create/configure the VPN interface
# and perform raw network operations.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

# Do not allow privilege escalation beyond the capabilities
# explicitly granted above.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
