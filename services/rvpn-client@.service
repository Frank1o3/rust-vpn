[Unit]
Description=RVPN Client (%i)
Documentation=https://github.com/Frank1o3/rust-vpn

Wants=network-online.target
After=network-online.target

# The client uses the per-user XDG runtime directory for its
# control socket. Ensure that runtime directory exists first.
Requires=user-runtime-dir@%U.service
After=user-runtime-dir@%U.service

[Service]
Type=simple

# Run the daemon as the target user's normal account.
# The instance name is the Linux username.
User=%i

# Match the runtime environment used by the user's tray service.
# %U is the numeric UID of User=%i.
Environment=XDG_RUNTIME_DIR=/run/user/%U

# The daemon owns the per-user IPC socket. The tray runs in the
# same user context and can therefore connect to it.
ExecStart=/usr/local/bin/rvpn-client --daemon

Restart=on-failure
RestartSec=3s

# Allow the non-root daemon to create/configure the VPN interface
# and perform raw network operations.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

# Do not allow privilege escalation beyond the capabilities
# explicitly granted above.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
